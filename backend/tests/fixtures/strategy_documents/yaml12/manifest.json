{
  "schema": "yaml12-cross-runtime/1",
  "cases": [
    {
      "name": "quoted_date_and_version",
      "file": "accepted/quoted_date_and_version.yaml",
      "expect": "accept",
      "json": {
        "schema_version": "1.0",
        "data": {
          "start": "2021-01-01",
          "end": "2026-08-31"
        }
      }
    },
    {
      "name": "plain_date_stays_string",
      "file": "accepted/plain_date_stays_string.yaml",
      "expect": "accept",
      "json": {
        "start": "2021-01-01"
      }
    },
    {
      "name": "yaml11_bool_words_are_strings",
      "file": "accepted/yaml11_bool_words_are_strings.yaml",
      "expect": "accept",
      "json": {
        "a": "yes",
        "b": "no",
        "c": "on",
        "d": "off",
        "e": "Yes",
        "f": "NO"
      }
    },
    {
      "name": "core_schema_booleans",
      "file": "accepted/core_schema_booleans.yaml",
      "expect": "accept",
      "json": {
        "a": true,
        "b": false,
        "c": true,
        "d": false
      }
    },
    {
      "name": "leading_zero_is_decimal",
      "file": "accepted/leading_zero_is_decimal.yaml",
      "expect": "accept",
      "json": {
        "a": 10,
        "b": 8,
        "c": 31
      }
    },
    {
      "name": "numbers",
      "file": "accepted/numbers.yaml",
      "expect": "accept",
      "json": {
        "one": 1,
        "float_one": 1.0,
        "sci": 0.01,
        "neg": -0.5,
        "plus": 5,
        "big": 12345678901
      }
    },
    {
      "name": "null_forms",
      "file": "accepted/null_forms.yaml",
      "expect": "accept",
      "json": {
        "a": null,
        "b": null,
        "c": null,
        "d": null
      }
    },
    {
      "name": "comments_and_blank_lines",
      "file": "accepted/comments_and_blank_lines.yaml",
      "expect": "accept",
      "json": {
        "title": "x",
        "risk": {
          "max_name_weight": 0.05
        }
      }
    },
    {
      "name": "nested_sequences",
      "file": "accepted/nested_sequences.yaml",
      "expect": "accept",
      "json": {
        "factors": [
          {
            "id": "a",
            "nodes": [
              1,
              2,
              3
            ]
          },
          {
            "id": "b",
            "nodes": []
          }
        ],
        "empty_map": {}
      }
    },
    {
      "name": "unicode_and_quotes",
      "file": "accepted/unicode_and_quotes.yaml",
      "expect": "accept",
      "json": {
        "title": "퀄리티 모멘텀",
        "label": "모멘텀",
        "plain": "한글"
      }
    },
    {
      "name": "block_scalars",
      "file": "accepted/block_scalars.yaml",
      "expect": "accept",
      "json": {
        "description": "line one\nline two\n",
        "folded": "a b"
      }
    },
    {
      "name": "single_document_start_marker",
      "file": "accepted/single_document_start_marker.yaml",
      "expect": "accept",
      "json": {
        "title": "x"
      }
    },
    {
      "name": "underscore_digits",
      "file": "rejected/underscore_digits.yaml",
      "expect": "reject",
      "reason": "ambiguous_number_underscore"
    },
    {
      "name": "not_a_number",
      "file": "rejected/not_a_number.yaml",
      "expect": "reject",
      "reason": "non_finite_number"
    },
    {
      "name": "infinity",
      "file": "rejected/infinity.yaml",
      "expect": "reject",
      "reason": "non_finite_number"
    },
    {
      "name": "duplicate_key",
      "file": "rejected/duplicate_key.yaml",
      "expect": "reject",
      "reason": "duplicate_key"
    },
    {
      "name": "merge_key",
      "file": "rejected/merge_key.yaml",
      "expect": "reject",
      "reason": "anchor_or_alias"
    },
    {
      "name": "alias",
      "file": "rejected/alias.yaml",
      "expect": "reject",
      "reason": "anchor_or_alias"
    },
    {
      "name": "custom_tag",
      "file": "rejected/custom_tag.yaml",
      "expect": "reject",
      "reason": "tag"
    },
    {
      "name": "binary_tag",
      "file": "rejected/binary_tag.yaml",
      "expect": "reject",
      "reason": "tag"
    },
    {
      "name": "multiple_documents",
      "file": "rejected/multiple_documents.yaml",
      "expect": "reject",
      "reason": "multiple_documents"
    },
    {
      "name": "directive",
      "file": "rejected/directive.yaml",
      "expect": "reject",
      "reason": "directive"
    },
    {
      "name": "integer_key",
      "file": "rejected/integer_key.yaml",
      "expect": "reject",
      "reason": "non_string_key"
    },
    {
      "name": "complex_key",
      "file": "rejected/complex_key.yaml",
      "expect": "reject",
      "reason": "non_string_key"
    },
    {
      "name": "empty_document",
      "file": "rejected/empty_document.yaml",
      "expect": "reject",
      "reason": "not_a_mapping"
    },
    {
      "name": "scalar_document",
      "file": "rejected/scalar_document.yaml",
      "expect": "reject",
      "reason": "not_a_mapping"
    },
    {
      "name": "sequence_document",
      "file": "rejected/sequence_document.yaml",
      "expect": "reject",
      "reason": "not_a_mapping"
    },
    {
      "name": "syntax_error",
      "file": "rejected/syntax_error.yaml",
      "expect": "reject",
      "reason": "syntax"
    }
  ]
}
