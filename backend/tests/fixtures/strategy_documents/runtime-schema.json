{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:strategy-workbench:strategy-document:1.2",
  "title": "StrategyDocument",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.2"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "eligibility": {
      "$ref": "#/$defs/EligibilityStep",
      "default": {
        "rules": []
      }
    },
    "factors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FactorSignal"
      },
      "default": []
    },
    "signal": {
      "$ref": "#/$defs/SignalStep",
      "default": {
        "normalization": "rank",
        "score_threshold": null,
        "regime_field_id": null,
        "regime_minimum": null
      }
    },
    "portfolio": {
      "$ref": "#/$defs/PortfolioStep",
      "default": {
        "side": "long_only",
        "selection_count": 20,
        "weighting": "equal",
        "rebalance": "monthly",
        "selection_method": "top_n",
        "short_selection_count": 20,
        "selection_percentile": 0.1,
        "rebalance_every_n_sessions": 21,
        "turnover_buffer_count": 0,
        "minimum_trade_weight": 0.0,
        "liquidity_field_id": null,
        "minimum_liquidity": null
      }
    },
    "risk": {
      "$ref": "#/$defs/RiskStep",
      "default": {
        "gross_exposure": 1.0,
        "net_exposure": 1.0,
        "max_name_weight": 0.1,
        "max_sector_weight": 0.3,
        "sector_neutral": false,
        "risk_field_id": null
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/FloatParameter"
          },
          {
            "$ref": "#/$defs/IntegerParameter"
          },
          {
            "$ref": "#/$defs/ChoiceParameter"
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      },
      "default": [],
      "x-defines": "parameter"
    }
  },
  "required": [
    "schema_version",
    "title"
  ],
  "additionalProperties": false,
  "$defs": {
    "EligibilityRule": {
      "type": "object",
      "title": "EligibilityRule",
      "properties": {
        "field_id": {
          "type": "string",
          "x-catalog": "equity-field"
        },
        "operator": {
          "type": "string",
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq",
            "top_percent",
            "top_count"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "field_id",
        "operator",
        "value"
      ],
      "additionalProperties": false
    },
    "EligibilityStep": {
      "type": "object",
      "title": "EligibilityStep",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EligibilityRule"
          },
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "FieldNode": {
      "type": "object",
      "title": "FieldNode",
      "properties": {
        "kind": {
          "type": "string",
          "const": "field"
        },
        "node_id": {
          "type": "string"
        },
        "field_id": {
          "type": "string",
          "x-catalog": "equity-field"
        }
      },
      "required": [
        "kind",
        "node_id",
        "field_id"
      ],
      "additionalProperties": false
    },
    "ConstantNode": {
      "type": "object",
      "title": "ConstantNode",
      "properties": {
        "kind": {
          "type": "string",
          "const": "constant"
        },
        "node_id": {
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "node_id",
        "value"
      ],
      "additionalProperties": false
    },
    "ParameterNode": {
      "type": "object",
      "title": "ParameterNode",
      "properties": {
        "kind": {
          "type": "string",
          "const": "parameter"
        },
        "node_id": {
          "type": "string"
        },
        "parameter_id": {
          "type": "string",
          "x-reference": "parameter"
        }
      },
      "required": [
        "kind",
        "node_id",
        "parameter_id"
      ],
      "additionalProperties": false
    },
    "UnaryNode": {
      "type": "object",
      "title": "UnaryNode",
      "properties": {
        "kind": {
          "type": "string",
          "const": "unary"
        },
        "node_id": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "negate",
            "lag"
          ]
        },
        "input_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "periods": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "node_id",
        "operator",
        "input_node_id"
      ],
      "additionalProperties": false
    },
    "BinaryNode": {
      "type": "object",
      "title": "BinaryNode",
      "properties": {
        "kind": {
          "type": "string",
          "const": "binary"
        },
        "node_id": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "add",
            "subtract",
            "multiply",
            "divide"
          ]
        },
        "left_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "right_node_id": {
          "type": "string",
          "x-reference": "node"
        }
      },
      "required": [
        "kind",
        "node_id",
        "operator",
        "left_node_id",
        "right_node_id"
      ],
      "additionalProperties": false
    },
    "TimeSeriesNode": {
      "type": "object",
      "title": "TimeSeriesNode",
      "properties": {
        "kind": {
          "type": "string",
          "const": "time_series"
        },
        "node_id": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "mean",
            "std",
            "momentum",
            "delta",
            "min",
            "max"
          ]
        },
        "input_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "window": {
          "type": "integer"
        },
        "lag": {
          "type": "integer",
          "default": 0
        }
      },
      "required": [
        "kind",
        "node_id",
        "operator",
        "input_node_id",
        "window"
      ],
      "additionalProperties": false
    },
    "CrossSectionalNode": {
      "type": "object",
      "title": "CrossSectionalNode",
      "properties": {
        "kind": {
          "type": "string",
          "const": "cross_sectional"
        },
        "node_id": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "rank",
            "zscore",
            "winsorize",
            "demean"
          ]
        },
        "input_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "lower_quantile": {
          "type": "number",
          "default": 0.01
        },
        "upper_quantile": {
          "type": "number",
          "default": 0.99
        }
      },
      "required": [
        "kind",
        "node_id",
        "operator",
        "input_node_id"
      ],
      "additionalProperties": false
    },
    "GroupNode": {
      "type": "object",
      "title": "GroupNode",
      "properties": {
        "kind": {
          "type": "string",
          "const": "group"
        },
        "node_id": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "neutralize",
            "rank"
          ]
        },
        "input_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "group_field_id": {
          "type": "string",
          "x-catalog": "equity-field"
        }
      },
      "required": [
        "kind",
        "node_id",
        "operator",
        "input_node_id",
        "group_field_id"
      ],
      "additionalProperties": false
    },
    "ComparisonNode": {
      "type": "object",
      "title": "ComparisonNode",
      "properties": {
        "kind": {
          "type": "string",
          "const": "comparison"
        },
        "node_id": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq"
          ]
        },
        "left_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "right_node_id": {
          "type": "string",
          "x-reference": "node"
        }
      },
      "required": [
        "kind",
        "node_id",
        "operator",
        "left_node_id",
        "right_node_id"
      ],
      "additionalProperties": false
    },
    "ConditionalNode": {
      "type": "object",
      "title": "ConditionalNode",
      "properties": {
        "kind": {
          "type": "string",
          "const": "conditional"
        },
        "node_id": {
          "type": "string"
        },
        "predicate_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "true_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "false_node_id": {
          "type": "string",
          "x-reference": "node"
        }
      },
      "required": [
        "kind",
        "node_id",
        "predicate_node_id",
        "true_node_id",
        "false_node_id"
      ],
      "additionalProperties": false
    },
    "SavedFactorNode": {
      "type": "object",
      "title": "SavedFactorNode",
      "properties": {
        "kind": {
          "type": "string",
          "const": "saved_factor"
        },
        "node_id": {
          "type": "string"
        },
        "factor_id": {
          "type": "string",
          "x-catalog": "factor"
        }
      },
      "required": [
        "kind",
        "node_id",
        "factor_id"
      ],
      "additionalProperties": false
    },
    "SavedSubgraphNode": {
      "type": "object",
      "title": "SavedSubgraphNode",
      "properties": {
        "kind": {
          "type": "string",
          "const": "saved_subgraph"
        },
        "node_id": {
          "type": "string"
        },
        "subgraph_id": {
          "type": "string",
          "x-catalog": "subgraph"
        }
      },
      "required": [
        "kind",
        "node_id",
        "subgraph_id"
      ],
      "additionalProperties": false
    },
    "FactorGraph": {
      "type": "object",
      "title": "FactorGraph",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/FieldNode"
              },
              {
                "$ref": "#/$defs/ConstantNode"
              },
              {
                "$ref": "#/$defs/ParameterNode"
              },
              {
                "$ref": "#/$defs/UnaryNode"
              },
              {
                "$ref": "#/$defs/BinaryNode"
              },
              {
                "$ref": "#/$defs/TimeSeriesNode"
              },
              {
                "$ref": "#/$defs/CrossSectionalNode"
              },
              {
                "$ref": "#/$defs/GroupNode"
              },
              {
                "$ref": "#/$defs/ComparisonNode"
              },
              {
                "$ref": "#/$defs/ConditionalNode"
              },
              {
                "$ref": "#/$defs/SavedFactorNode"
              },
              {
                "$ref": "#/$defs/SavedSubgraphNode"
              }
            ],
            "discriminator": {
              "propertyName": "kind"
            }
          },
          "x-defines": "node"
        },
        "output_node_id": {
          "type": "string",
          "x-reference": "node"
        }
      },
      "required": [
        "nodes",
        "output_node_id"
      ],
      "additionalProperties": false
    },
    "FactorSignal": {
      "type": "object",
      "title": "FactorSignal",
      "properties": {
        "factor_id": {
          "type": "string",
          "x-authoring-source": "factor_id",
          "x-authoring-identity": true
        },
        "label": {
          "type": "string",
          "x-authoring-source": "label",
          "x-default-from": "factor_id"
        },
        "direction": {
          "type": "string",
          "enum": [
            "high",
            "low"
          ],
          "x-authoring-source": "preference"
        },
        "weight": {
          "type": "number",
          "default": 1.0,
          "x-authoring-default": 1.0
        },
        "graph": {
          "$ref": "#/$defs/FactorGraph",
          "x-authoring-source": "default_graph"
        }
      },
      "required": [
        "factor_id",
        "direction",
        "graph"
      ],
      "additionalProperties": false
    },
    "SignalStep": {
      "type": "object",
      "title": "SignalStep",
      "properties": {
        "normalization": {
          "type": "string",
          "enum": [
            "none",
            "rank",
            "zscore"
          ],
          "default": "rank"
        },
        "score_threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "regime_field_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "x-catalog": "equity-field"
        },
        "regime_minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "x-applicable-when": {
            "all_of": [
              {
                "pointer": "/signal/regime_field_id",
                "equals": null,
                "not_null": true
              }
            ],
            "description_key": "strategy.contract.applicable.regime_minimum",
            "owned_by_error": "strategy.signal.regime_field"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "PortfolioStep": {
      "type": "object",
      "title": "PortfolioStep",
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "long_only",
            "long_short"
          ],
          "default": "long_only"
        },
        "selection_count": {
          "type": "integer",
          "default": 20,
          "x-unit": "count",
          "x-applied-stage": "portfolio",
          "minimum": 1,
          "examples": [
            20
          ],
          "x-description-key": "strategy.contract.portfolio.selection_count",
          "x-applicable-when": {
            "all_of": [
              {
                "pointer": "/portfolio/selection_method",
                "equals": "top_n",
                "not_null": false
              }
            ],
            "description_key": "strategy.contract.applicable.selection_count",
            "owned_by_error": null
          }
        },
        "weighting": {
          "type": "string",
          "enum": [
            "equal",
            "factor_score",
            "rank",
            "risk"
          ],
          "default": "equal"
        },
        "rebalance": {
          "type": "string",
          "enum": [
            "every_n_sessions",
            "weekly",
            "monthly",
            "quarterly"
          ],
          "default": "monthly"
        },
        "selection_method": {
          "type": "string",
          "enum": [
            "top_n",
            "percentile"
          ],
          "default": "top_n"
        },
        "short_selection_count": {
          "type": "integer",
          "default": 20,
          "x-unit": "count",
          "x-applied-stage": "portfolio",
          "minimum": 1,
          "examples": [
            20
          ],
          "x-description-key": "strategy.contract.portfolio.short_selection_count",
          "x-applicable-when": {
            "all_of": [
              {
                "pointer": "/portfolio/side",
                "equals": "long_short",
                "not_null": false
              },
              {
                "pointer": "/portfolio/selection_method",
                "equals": "top_n",
                "not_null": false
              }
            ],
            "description_key": "strategy.contract.applicable.short_selection_count",
            "owned_by_error": null
          }
        },
        "selection_percentile": {
          "type": "number",
          "default": 0.1,
          "x-unit": "ratio",
          "x-applied-stage": "portfolio",
          "exclusiveMinimum": 0.0,
          "maximum": 0.5,
          "x-display-unit": "%",
          "examples": [
            0.1
          ],
          "x-description-key": "strategy.contract.portfolio.selection_percentile",
          "x-applicable-when": {
            "all_of": [
              {
                "pointer": "/portfolio/selection_method",
                "equals": "percentile",
                "not_null": false
              }
            ],
            "description_key": "strategy.contract.applicable.selection_percentile",
            "owned_by_error": null
          }
        },
        "rebalance_every_n_sessions": {
          "type": "integer",
          "default": 21,
          "x-unit": "sessions",
          "x-applied-stage": "portfolio",
          "minimum": 1,
          "examples": [
            21
          ],
          "x-description-key": "strategy.contract.portfolio.rebalance_every_n_sessions",
          "x-applicable-when": {
            "all_of": [
              {
                "pointer": "/portfolio/rebalance",
                "equals": "every_n_sessions",
                "not_null": false
              }
            ],
            "description_key": "strategy.contract.applicable.rebalance_every_n_sessions",
            "owned_by_error": null
          }
        },
        "turnover_buffer_count": {
          "type": "integer",
          "default": 0,
          "x-unit": "count",
          "x-applied-stage": "portfolio",
          "minimum": 0,
          "examples": [
            0
          ],
          "x-description-key": "strategy.contract.portfolio.turnover_buffer_count"
        },
        "minimum_trade_weight": {
          "type": "number",
          "default": 0.0,
          "x-unit": "ratio",
          "x-applied-stage": "portfolio",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-display-unit": "%",
          "examples": [
            0.0
          ],
          "x-description-key": "strategy.contract.portfolio.minimum_trade_weight"
        },
        "liquidity_field_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "x-catalog": "equity-field"
        },
        "minimum_liquidity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "x-unit": "field",
          "x-applied-stage": "eligibility",
          "minimum": 0.0,
          "x-description-key": "strategy.contract.portfolio.minimum_liquidity",
          "x-applicable-when": {
            "all_of": [
              {
                "pointer": "/portfolio/liquidity_field_id",
                "equals": null,
                "not_null": true
              }
            ],
            "description_key": "strategy.contract.applicable.minimum_liquidity",
            "owned_by_error": "strategy.portfolio.liquidity_field"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "RiskStep": {
      "type": "object",
      "title": "RiskStep",
      "properties": {
        "gross_exposure": {
          "type": "number",
          "default": 1.0,
          "x-unit": "ratio",
          "x-applied-stage": "risk",
          "exclusiveMinimum": 0.0,
          "x-display-unit": "%",
          "examples": [
            1.0
          ],
          "x-description-key": "strategy.contract.risk.gross_exposure"
        },
        "net_exposure": {
          "type": "number",
          "default": 1.0
        },
        "max_name_weight": {
          "type": "number",
          "default": 0.1,
          "x-unit": "ratio",
          "x-applied-stage": "risk",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "x-display-unit": "%",
          "examples": [
            0.05
          ],
          "x-description-key": "strategy.contract.risk.max_name_weight"
        },
        "max_sector_weight": {
          "type": "number",
          "default": 0.3,
          "x-unit": "ratio",
          "x-applied-stage": "risk",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "x-display-unit": "%",
          "examples": [
            0.25
          ],
          "x-description-key": "strategy.contract.risk.max_sector_weight"
        },
        "sector_neutral": {
          "type": "boolean",
          "default": false,
          "x-applicable-when": {
            "all_of": [
              {
                "pointer": "/portfolio/side",
                "equals": "long_short",
                "not_null": false
              }
            ],
            "description_key": "strategy.contract.applicable.sector_neutral",
            "owned_by_error": "strategy.risk.sector_neutral_side"
          }
        },
        "risk_field_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "x-applicable-when": {
            "all_of": [
              {
                "pointer": "/portfolio/weighting",
                "equals": "risk",
                "not_null": false
              }
            ],
            "description_key": "strategy.contract.applicable.risk_field_id",
            "owned_by_error": null
          },
          "x-catalog": "equity-field"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "FloatParameter": {
      "type": "object",
      "title": "FloatParameter",
      "properties": {
        "kind": {
          "type": "string",
          "const": "float"
        },
        "parameter_id": {
          "type": "string"
        },
        "default": {
          "type": "number"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "parameter_id",
        "default",
        "minimum",
        "maximum"
      ],
      "additionalProperties": false
    },
    "IntegerParameter": {
      "type": "object",
      "title": "IntegerParameter",
      "properties": {
        "kind": {
          "type": "string",
          "const": "integer"
        },
