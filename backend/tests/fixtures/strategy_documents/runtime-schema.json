    "portfolio": {
      "$ref": "#/$defs/PortfolioStep",
      "default": {
        "side": "long_only",
        "selection_count": 20,
        "weighting": "equal",
        "rebalance": "monthly",
        "selection_method": "top_n",
        "short_selection_count": 20,
        "selection_percentile": 0.1,
        "rebalance_every_n_sessions": 21,
        "turnover_buffer_count": 0,
        "minimum_trade_weight": 0.0,
        "liquidity_field_id": null,
        "minimum_liquidity": null
      },
      "x-description-key": "strategy.section.portfolio"
    },
    "risk": {
      "$ref": "#/$defs/RiskStep",
      "default": {
        "gross_exposure": 1.0,
        "net_exposure": 1.0,
        "max_name_weight": 0.1,
        "max_sector_weight": 0.3,
        "sector_neutral": false,
        "risk_field_id": null
      },
      "x-description-key": "strategy.section.risk"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionStep",
      "default": {
        "timing": "next_open",
        "participation_rate": 0.1,
        "fee_bps": 15.0,
        "slippage_bps": 10.0
