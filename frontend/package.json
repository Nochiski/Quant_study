{
  "name": "quant-strategy-workbench-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run check:editor-bundle",
    "check:editor-bundle": "node scripts/check-editor-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "typecheck:e2e": "tsc --project tsconfig.playwright.json --noEmit",
    "test:e2e": "npm run build && npm run typecheck:e2e && node e2e/run-playwright.mjs",
    "test:e2e:update": "npm run build && npm run typecheck:e2e && node e2e/run-playwright.mjs --update-snapshots",
    "test:e2e:report": "playwright show-report",
    "api:schema": "cd ../backend && uv run python scripts/export_openapi.py openapi.json",
    "api:generate": "npm run api:schema && openapi-ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.2",
    "@codemirror/view": "6.43.11",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@lezer/highlight": "1.2.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "1.170.32",
    "codemirror": "6.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@boundaries/eslint-plugin": "^7.2.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.97.3",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.18.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
