{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:strategy-workbench:strategy-document:1.0",
  "title": "StrategyDocument",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/DataStep"
    },
    "eligibility": {
      "$ref": "#/$defs/EligibilityStep"
    },
    "factors": {
      "$ref": "#/$defs/FactorStep"
    },
    "signal": {
      "$ref": "#/$defs/SignalStep"
    },
    "portfolio": {
      "$ref": "#/$defs/PortfolioStep"
    },
    "risk": {
      "$ref": "#/$defs/RiskStep"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionStep"
    },
    "parameters": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/FloatParameter"
          },
          {
            "$ref": "#/$defs/IntegerParameter"
          },
          {
            "$ref": "#/$defs/ChoiceParameter"
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      },
      "default": []
    }
  },
  "required": [
    "schema_version",
    "title",
    "description",
    "data",
    "eligibility",
    "factors",
    "signal",
    "portfolio",
    "risk",
    "execution"
  ],
  "additionalProperties": false,
  "$defs": {
    "DataStep": {
      "type": "object",
      "title": "DataStep",
      "properties": {
        "market": {
          "type": "string",
          "enum": [
            "KRX"
          ]
        },
        "start": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "universe_id": {
          "type": "string",
          "x-catalog": "universe"
        },
        "frequency": {
          "type": "string",
          "enum": [
            "daily"
          ],
          "default": "daily"
        }
      },
      "required": [
        "market",
        "start",
        "end",
        "universe_id"
      ],
      "additionalProperties": false
    },
    "EligibilityRule": {
      "type": "object",
      "title": "EligibilityRule",
      "properties": {
        "field_id": {
          "type": "string",
          "x-catalog": "equity-field"
        },
        "operator": {
          "type": "string",
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq"
          ]
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "field_id",
        "operator",
        "value"
      ],
      "additionalProperties": false
    },
    "EligibilityStep": {
      "type": "object",
      "title": "EligibilityStep",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EligibilityRule"
          },
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "FieldNode": {
      "type": "object",
      "title": "FieldNode",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "field_id": {
          "type": "string",
          "x-catalog": "equity-field"
        },
        "kind": {
          "type": "string",
          "const": "field"
        }
      },
      "required": [
        "node_id",
        "field_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "ConstantNode": {
      "type": "object",
      "title": "ConstantNode",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "kind": {
          "type": "string",
          "const": "constant"
        }
      },
      "required": [
        "node_id",
        "value",
        "kind"
      ],
      "additionalProperties": false
    },
    "ParameterNode": {
      "type": "object",
      "title": "ParameterNode",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "parameter_id": {
          "type": "string",
          "x-reference": "parameter"
        },
        "kind": {
          "type": "string",
          "const": "parameter"
        }
      },
      "required": [
        "node_id",
        "parameter_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "UnaryNode": {
      "type": "object",
      "title": "UnaryNode",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "negate",
            "lag",
            "rank",
            "zscore",
            "winsorize",
            "neutralize"
          ]
        },
        "input_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "kind": {
          "type": "string",
          "const": "unary"
        },
        "periods": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "node_id",
        "operator",
        "input_node_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "BinaryNode": {
      "type": "object",
      "title": "BinaryNode",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "add",
            "subtract",
            "multiply",
            "divide"
          ]
        },
        "left_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "right_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "kind": {
          "type": "string",
          "const": "binary"
        }
      },
      "required": [
        "node_id",
        "operator",
        "left_node_id",
        "right_node_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "TimeSeriesNode": {
      "type": "object",
      "title": "TimeSeriesNode",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "mean",
            "std",
            "momentum",
            "delta",
            "min",
            "max"
          ]
        },
        "input_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "window": {
          "type": "integer"
        },
        "kind": {
          "type": "string",
          "const": "time_series"
        },
        "lag": {
          "type": "integer",
          "default": 0
        }
      },
      "required": [
        "node_id",
        "operator",
        "input_node_id",
        "window",
        "kind"
      ],
      "additionalProperties": false
    },
    "CrossSectionalNode": {
      "type": "object",
      "title": "CrossSectionalNode",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "rank",
            "zscore",
            "winsorize"
          ]
        },
        "input_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "kind": {
          "type": "string",
          "const": "cross_sectional"
        },
        "lower_quantile": {
          "type": "number",
          "default": 0.01
        },
        "upper_quantile": {
          "type": "number",
          "default": 0.99
        }
      },
      "required": [
        "node_id",
        "operator",
        "input_node_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "GroupNode": {
      "type": "object",
      "title": "GroupNode",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "neutralize",
            "rank"
          ]
        },
        "input_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "group_field_id": {
          "type": "string",
          "x-catalog": "equity-field"
        },
        "kind": {
          "type": "string",
          "const": "group"
        }
      },
      "required": [
        "node_id",
        "operator",
        "input_node_id",
        "group_field_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "ComparisonNode": {
      "type": "object",
      "title": "ComparisonNode",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq"
          ]
        },
        "left_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "right_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "kind": {
          "type": "string",
          "const": "comparison"
        }
      },
      "required": [
        "node_id",
        "operator",
        "left_node_id",
        "right_node_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "ConditionalNode": {
      "type": "object",
      "title": "ConditionalNode",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "predicate_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "true_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "false_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "kind": {
          "type": "string",
          "const": "conditional"
        }
      },
      "required": [
        "node_id",
        "predicate_node_id",
        "true_node_id",
        "false_node_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "SavedFactorNode": {
      "type": "object",
      "title": "SavedFactorNode",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "factor_id": {
          "type": "string",
          "x-catalog": "factor"
        },
        "kind": {
          "type": "string",
          "const": "saved_factor"
        }
      },
      "required": [
        "node_id",
        "factor_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "SavedSubgraphNode": {
      "type": "object",
      "title": "SavedSubgraphNode",
      "properties": {
        "node_id": {
          "type": "string"
        },
        "subgraph_id": {
          "type": "string",
          "x-catalog": "subgraph"
        },
        "kind": {
          "type": "string",
          "const": "saved_subgraph"
        }
      },
      "required": [
        "node_id",
        "subgraph_id",
        "kind"
      ],
      "additionalProperties": false
    },
    "FactorGraph": {
      "type": "object",
      "title": "FactorGraph",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/FieldNode"
              },
              {
                "$ref": "#/$defs/ConstantNode"
              },
              {
                "$ref": "#/$defs/ParameterNode"
              },
              {
                "$ref": "#/$defs/UnaryNode"
              },
              {
                "$ref": "#/$defs/BinaryNode"
              },
              {
                "$ref": "#/$defs/TimeSeriesNode"
              },
              {
                "$ref": "#/$defs/CrossSectionalNode"
              },
              {
                "$ref": "#/$defs/GroupNode"
              },
              {
                "$ref": "#/$defs/ComparisonNode"
              },
              {
                "$ref": "#/$defs/ConditionalNode"
              },
              {
                "$ref": "#/$defs/SavedFactorNode"
              },
              {
                "$ref": "#/$defs/SavedSubgraphNode"
              }
            ],
            "discriminator": {
              "propertyName": "kind"
            }
          }
        },
        "output_node_id": {
          "type": "string",
          "x-reference": "node"
        },
        "missing_policy": {
          "type": "string",
          "enum": [
            "drop",
            "keep",
            "zero",
            "cross_sectional_median"
          ],
          "default": "drop"
        }
      },
      "required": [
        "nodes",
        "output_node_id"
      ],
      "additionalProperties": false
    },
    "FactorSignal": {
      "type": "object",
      "title": "FactorSignal",
      "properties": {
        "factor_id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "direction": {
          "type": "string",
          "enum": [
            "high",
            "low"
          ]
        },
        "weight": {
          "type": "number"
        },
        "graph": {
          "$ref": "#/$defs/FactorGraph"
        }
      },
      "required": [
        "factor_id",
        "label",
        "direction",
        "weight",
        "graph"
      ],
      "additionalProperties": false
    },
    "FactorStep": {
      "type": "object",
      "title": "FactorStep",
      "properties": {
        "factors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FactorSignal"
          }
        }
      },
      "required": [
        "factors"
      ],
      "additionalProperties": false
    },
    "SignalStep": {
      "type": "object",
      "title": "SignalStep",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "weighted_sum",
            "rank_threshold"
          ],
          "default": "weighted_sum"
        },
        "entry_percentile": {
          "type": "number",
          "default": 0.1,
          "x-unit": "ratio",
          "x-applied-stage": "signal",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "x-display-unit": "%",
          "examples": [
            0.1
          ],
          "x-description-key": "strategy.contract.signal.entry_percentile"
        },
        "score_threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "regime_field_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "x-catalog": "equity-field"
        },
        "regime_minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "PortfolioStep": {
      "type": "object",
      "title": "PortfolioStep",
      "properties": {
        "side": {
          "type": "string",
          "enum": [
            "long_only",
            "long_short"
          ],
          "default": "long_only"
        },
        "selection_count": {
          "type": "integer",
          "default": 20,
          "x-unit": "count",
          "x-applied-stage": "portfolio",
          "minimum": 1,
          "examples": [
            20
          ],
          "x-description-key": "strategy.contract.portfolio.selection_count"
        },
        "weighting": {
          "type": "string",
          "enum": [
            "equal",
            "factor_score",
            "rank",
            "risk"
          ],
          "default": "equal"
        },
        "rebalance": {
          "type": "string",
          "enum": [
            "every_n_sessions",
            "weekly",
            "monthly",
            "quarterly"
          ],
          "default": "monthly"
        },
        "selection_method": {
          "type": "string",
          "enum": [
            "top_n",
            "percentile"
          ],
          "default": "top_n"
        },
        "short_selection_count": {
          "type": "integer",
          "default": 20,
          "x-unit": "count",
          "x-applied-stage": "portfolio",
          "minimum": 1,
          "examples": [
            20
          ],
          "x-description-key": "strategy.contract.portfolio.short_selection_count"
        },
        "selection_percentile": {
          "type": "number",
          "default": 0.1,
          "x-unit": "ratio",
          "x-applied-stage": "portfolio",
          "exclusiveMinimum": 0.0,
          "maximum": 0.5,
          "x-display-unit": "%",
          "examples": [
            0.1
          ],
          "x-description-key": "strategy.contract.portfolio.selection_percentile"
        },
        "rebalance_every_n_sessions": {
          "type": "integer",
          "default": 21,
          "x-unit": "sessions",
          "x-applied-stage": "portfolio",
          "minimum": 1,
          "examples": [
            21
          ],
          "x-description-key": "strategy.contract.portfolio.rebalance_every_n_sessions"
        },
        "turnover_buffer_count": {
          "type": "integer",
          "default": 0,
          "x-unit": "count",
          "x-applied-stage": "portfolio",
          "minimum": 0,
          "examples": [
            0
          ],
          "x-description-key": "strategy.contract.portfolio.turnover_buffer_count"
        },
        "minimum_trade_weight": {
          "type": "number",
          "default": 0.0,
          "x-unit": "ratio",
          "x-applied-stage": "portfolio",
          "minimum": 0.0,
          "maximum": 1.0,
          "x-display-unit": "%",
          "examples": [
            0.0
          ],
          "x-description-key": "strategy.contract.portfolio.minimum_trade_weight"
        },
        "liquidity_field_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "x-catalog": "equity-field"
        },
        "minimum_liquidity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "x-unit": "field",
          "x-applied-stage": "eligibility",
          "minimum": 0.0,
          "x-description-key": "strategy.contract.portfolio.minimum_liquidity"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "RiskStep": {
      "type": "object",
      "title": "RiskStep",
      "properties": {
        "gross_exposure": {
          "type": "number",
          "default": 1.0,
          "x-unit": "ratio",
          "x-applied-stage": "risk",
          "exclusiveMinimum": 0.0,
          "x-display-unit": "%",
          "examples": [
            1.0
          ],
          "x-description-key": "strategy.contract.risk.gross_exposure"
        },
        "net_exposure": {
          "type": "number",
          "default": 1.0
        },
        "max_name_weight": {
          "type": "number",
          "default": 0.1,
          "x-unit": "ratio",
          "x-applied-stage": "risk",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "x-display-unit": "%",
          "examples": [
            0.05
          ],
          "x-description-key": "strategy.contract.risk.max_name_weight"
        },
        "max_sector_weight": {
          "type": "number",
          "default": 0.3,
          "x-unit": "ratio",
          "x-applied-stage": "risk",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "x-display-unit": "%",
          "examples": [
            0.25
          ],
          "x-description-key": "strategy.contract.risk.max_sector_weight"
        },
        "sector_neutral": {
          "type": "boolean",
          "default": false
        },
        "risk_field_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "x-catalog": "equity-field"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ExecutionStep": {
      "type": "object",
      "title": "ExecutionStep",
      "properties": {
        "timing": {
          "type": "string",
          "enum": [
            "next_open"
          ],
          "default": "next_open"
        },
        "order_style": {
          "type": "string",
          "enum": [
            "market"
          ],
          "default": "market"
        },
        "participation_rate": {
          "type": "number",
          "default": 0.1,
          "x-unit": "ratio",
          "x-applied-stage": "execution",
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "x-display-unit": "%",
          "examples": [
            0.1
          ],
          "x-description-key": "strategy.contract.execution.participation_rate"
        },
        "fee_bps": {
          "type": "number",
          "default": 15.0,
          "x-unit": "bps",
          "x-applied-stage": "execution",
          "minimum": 0.0,
          "x-display-unit": "bp",
          "examples": [
            15.0
          ],
          "x-description-key": "strategy.contract.execution.fee_bps"
        },
        "slippage_bps": {
          "type": "number",
          "default": 10.0,
          "x-unit": "bps",
          "x-applied-stage": "execution",
          "minimum": 0.0,
          "x-display-unit": "bp",
          "examples": [
            10.0
          ],
          "x-description-key": "strategy.contract.execution.slippage_bps"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "FloatParameter": {
      "type": "object",
      "title": "FloatParameter",
      "properties": {
        "parameter_id": {
          "type": "string"
        },
        "default": {
          "type": "number"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "kind": {
          "type": "string",
          "const": "float"
        },
        "step": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "parameter_id",
        "default",
        "minimum",
        "maximum",
        "kind"
      ],
      "additionalProperties": false
    },
    "IntegerParameter": {
      "type": "object",
      "title": "IntegerParameter",
      "properties": {
        "parameter_id": {
          "type": "string"
        },
        "default": {
          "type": "integer"
        },
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        },
        "kind": {
          "type": "string",
          "const": "integer"
        },
        "step": {
          "type": "integer",
          "default": 1
