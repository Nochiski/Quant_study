          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchCatalog"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Equity Catalog"
      }
    },
