      "UnaryNode": {
        "properties": {
          "input_node_id": {
            "title": "Input Node Id",
            "type": "string"
          },
          "kind": {
            "const": "unary",
            "title": "Kind",
            "type": "string"
          },
          "node_id": {
            "title": "Node Id",
            "type": "string"
          },
          "operator": {
            "$ref": "#/components/schemas/UnaryOperator"
          },
          "periods": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Periods"
          }
        },
        "required": [
          "node_id",
          "operator",
          "input_node_id",
          "kind"
        ],
        "title": "UnaryNode",
        "type": "object"
      },
      "UnaryOperator": {
        "enum": [
          "negate",
          "lag",
          "rank",
          "zscore"
        ],
        "title": "UnaryOperator",
        "type": "string"
      },
      "UniverseHistoryResult": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/UniversePoint"
            },
            "title": "Points",
            "type": "array"
          },
          "snapshot_id": {
            "title": "Snapshot Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/DataLoadStatus"
          }
        },
        "required": [
          "points",
          "status",
          "snapshot_id"
        ],
        "title": "UniverseHistoryResult",
        "type": "object"
      },
      "UniversePoint": {
        "properties": {
          "coverage": {
            "$ref": "#/components/schemas/CellKind",
            "default": "observed"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/SecurityRef"
            },
            "title": "Members",
            "type": "array"
          },
          "session": {
            "format": "date",
            "title": "Session",
            "type": "string"
          }
        },
        "required": [
          "session",
          "members"
        ],
        "title": "UniversePoint",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValidationIssue": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ValidationKind"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/ValidationSeverity",
            "default": "error"
          }
        },
        "required": [
          "code",
          "path",
          "message",
          "kind"
        ],
        "title": "ValidationIssue",
        "type": "object"
      },
      "ValidationKind": {
        "enum": [
          "syntax",
          "semantic",
          "capability"
        ],
        "title": "ValidationKind",
        "type": "string"
      },
      "ValidationSeverity": {
        "enum": [
          "error",
          "warning"
        ],
        "title": "ValidationSeverity",
        "type": "string"
      },
      "WeightingMethod": {
        "enum": [
          "equal",
          "factor_score",
          "rank"
        ],
        "title": "WeightingMethod",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "No-code factor strategy design and backtest orchestration API.",
