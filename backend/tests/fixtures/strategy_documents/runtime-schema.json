{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:strategy-workbench:strategy-document:1.1",
  "title": "StrategyDocument",
  "x-description-key": "strategy.document",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1",
      "x-description-key": "strategy.section.schema_version"
