      "x-description-key": "strategy.section.execution"
    },
    "parameters": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/FloatParameter"
          },
          {
            "$ref": "#/$defs/IntegerParameter"
          },
          {
            "$ref": "#/$defs/ChoiceParameter"
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      },
      "default": [],
      "x-description-key": "strategy.section.parameters",
      "x-defines": "parameter"
    }
